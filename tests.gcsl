import "github.com/gcslib/rust"
import "github.com/peios/peios-rs" as peios_rs

def test unit(tests: List<rust.RustTest> = rust.tests(crates(), "pki-core")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test policy(tests: List<rust.RustTest> = rust.tests(crates(), "pki-policy")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test keys(tests: List<rust.RustTest> = rust.tests(crates(), "pki-keys")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test store(tests: List<rust.RustTest> = rust.tests(crates(), "pki-store")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test pipeline(tests: List<rust.RustTest> = rust.tests(crates(), "pki-pipeline")) {
    let each = for test in tests { = rust.run_test(test) }
}

# The pkid crates, with libpeios placed for them to load. The runtime is a
# parameter default: building it fetches, which a test's body can't.
def test wire(
    tests: List<rust.RustTest> = rust.tests(native_crates(), "pkid-core"),
    given: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
) {
    let each = for test in tests {
        = rust.run_test(test, given = given, env = peios_rs.runtime_env())
    }
}

