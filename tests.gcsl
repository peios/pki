def test cli(
    tests: List<rust.RustTest> = rust.tests(native_crates(), "pki"),
    given: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
) {
    let each = for test in tests {
        = rust.run_test(test, given = given, env = peios_rs.runtime_env())
    }
}

def portable() -> List<String> {
    = ["pki-core", "pki-keys", "pki-pipeline", "pki-policy", "pki-store"]
}

def native() -> List<String> {
    = ["pki", "pki-management", "pkid", "pkid-core", "pkid-client"]
}

def test clippy(checked: List<List<{}>> = [
    ...for each in portable() { = rust.clippy(crates(), each, flags = ["-Dwarnings"]) },
    ...for each in native() { = rust.clippy(native_crates(), each, flags = ["-Dwarnings"]) },
]) {}

def test doctests(checked: List<List<{}>> = [
    ...for each in portable() { = rust.doctests(crates(), each) },
    ...for each in native() { = rust.doctests(native_crates(), each) },
]) {}
