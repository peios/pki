import "github.com/gcslib/rust"

def test unit(tests: List<rust.RustTest> = rust.tests(crates(), "pki-core")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test policy(tests: List<rust.RustTest> = rust.tests(crates(), "pki-policy")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test keys(tests: List<rust.RustTest> = rust.tests(crates(), "pki-keys")) {
    let each = for test in tests { = rust.run_test(test) }
}

def test clippy(checked: List<List<{}>> = for each in ["pki-core", "pki-keys", "pki-policy"] {
    = rust.clippy(crates(), each, flags = ["-Dwarnings"])
}) {}

def test doctests(checked: List<List<{}>> = for each in ["pki-core", "pki-keys", "pki-policy"] {
    = rust.doctests(crates(), each)
}) {}
