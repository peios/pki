import "github.com/gcslib/rust"
import "github.com/gcslib/clang"
import "github.com/peios/peios-rs" as peios_rs

def crates() -> rust.RustWorkspace {
    = rust.workspace(dir("."), rust.vendored(file("Cargo.lock")))
}

# The workspace with libpeios placed for `peios-sys`, for the crates that
# talk to Peios: pkid, its wire and its client, pki-management and pki.
def native_crates() -> rust.RustWorkspace {
    = rust.workspace(
        dir("."), rust.vendored(file("Cargo.lock")),
        crates = peios_rs.crate_settings(),
        libclang = [clang.libclang_18()],
    )
}

def build pkid() { = rust.bin(native_crates(), "pkid") }

def build pki() { = rust.bin(native_crates(), "pki") }
